# ─────────────────────────────────────────────────────────────
# CakeRecipe Finder — environment variables
# All keys are read server-side only. NEVER prefix secrets with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# ── AI (required for recipe synthesis) ──────────────────────
# Anthropic API key — used server-side for requirement parsing, recipe
# comparison and final recipe synthesis.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# ── Web search (one of these is strongly recommended) ───────
# Which provider to use: brave | tavily | serpapi | google | anthropic
# If unset, the first provider with a key is used. "anthropic" uses Claude's
# server-side web search tool and only needs ANTHROPIC_API_KEY.
SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
# Google Programmable Search (Custom Search JSON API)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# ── Maps / local stores (optional) ──────────────────────────
# If set, Google Places (New) Text Search is used for nearby stores.
# Otherwise OpenStreetMap (Nominatim + Overpass) is used — no key needed.
GOOGLE_MAPS_API_KEY=
# Contact e-mail sent in the User-Agent to OpenStreetMap services (their usage policy asks for one)
OSM_CONTACT_EMAIL=

# ── Database (optional but recommended) ─────────────────────
# PostgreSQL connection string. Without it the app still researches recipes
# (in-memory cache) but saving recipes, history and preferences are disabled.
DATABASE_URL=
# Max pool connections (use 1 for `npx prisma dev` local server)
DATABASE_POOL_MAX=10

# ── Security ────────────────────────────────────────────────
# Secret used to sign the anonymous profile cookie (32+ random chars)
SESSION_SECRET=
# Comma-separated list of origins allowed to call the API (no wildcards)
ALLOWED_ORIGINS=http://localhost:3000

# Value written to the `source` column of every DB insert (local | production).
# Defaults to "production" when NODE_ENV=production, otherwise "local".
DATA_SOURCE=
